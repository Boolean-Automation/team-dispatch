# /build + Ship runtime state
.ship/
.build-runs/*/
!.build-runs/.gitkeep
node_modules/
.DS_Store
# /build runtime state

# Build output + TS incremental
dist/
*.tsbuildinfo

# Local HTTPS dev cert (self-signed; serve-https.mjs generates it — never commit a private key)
.https-cert/

# Env files (never commit secrets)
.env
.env.local
.env.*.local

# pnpm
.pnpm-store/

# Playwright MCP artifacts
.playwright-mcp/

# Playwright E2E runtime artifacts (test-results + report auto-generated)
e2e/test-results/
e2e/playwright-report/
