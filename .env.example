# dispatch — environment variables
# Copy to .env and fill in values before running locally.
# NEVER commit a .env file with real secrets.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (Railway Postgres plugin or local) ───────────────────────────────
# Railway injects DATABASE_URL automatically for the managed Postgres plugin.
# For local dev: postgres://user:password@localhost:5432/dispatch
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dispatch

# ── Clerk Auth ─────────────────────────────────────────────────────────────────
# Publishable key (safe to expose to browser — prefixed VITE_ for Vite)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key (server-side only — never expose to browser)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Slack ──────────────────────────────────────────────────────────────────────
# Slack bot token for read operations (channel membership discovery — Slice 4)
# SLACK_BOT_TOKEN=xoxb-...
#
# Slack signing secret for verifying Events API webhook signatures (Slice 4)
# SLACK_SIGNING_SECRET=...
#
# Write-back identity — OQ-2 RESOLVED: per-SE Slack user tokens.
# Replies post AS the sending SE's own Slack user. One token per SE, keyed by
# their Clerk user id. A reply whose SE has no token here fails gracefully
# (the slack_outbox row moves to 'failed' — never crashes the worker).
# SLACK_USER_TOKEN_<clerkUserId>=xoxp-...
# e.g. SLACK_USER_TOKEN_user_3DzgimkNCGSt10Uc4lIDmvhDeS8=xoxp-...

# ── MCP machine-credential auth (Slice 8) ────────────────────────────────────
# Secret used to sign and verify HS256 machine-credential JWTs for MCP access.
# Rotate to revoke all outstanding machine tokens at once (Phase 1 revocation).
# Must be a long random secret — at least 32 bytes.
# Generate: openssl rand -hex 32
MCP_SIGNING_SECRET=replace-with-openssl-rand-hex-32-output

# ── MCP client env vars (set on the operator's local machine, NOT on the server)
# Base URL of the dispatch API instance the MCP points at
DISPATCH_API_URL=http://localhost:3000
# Machine credential JWT minted by an admin via `pnpm --filter @dispatch/mcp mint-token`
DISPATCH_API_KEY=<machine-credential-jwt>

# ── DSP- ID scheme ─────────────────────────────────────────────────────────────
# Postgres sequence start value for display_id (DSP-####).
# The design uses DSP-2876; start at 2900 so demo data does not collide.
# Change this before Slice 3 ships if a different start is preferred.
DSP_ID_START=2900

# ── Undo window ────────────────────────────────────────────────────────────────
# Duration (seconds) of the pre-send undo buffer for Slack reply outbox.
# Default: 10s. Operator may tune this.
SLACK_SEND_WINDOW_SECS=10

# ── Companion bridge (Spike #1 — packages/companion) ─────────────────────────
# The Companion is a local per-SE process that surfaces the SE's own `claude`
# CLI in the dispatch web UI over an authenticated 127.0.0.1 WebSocket.
#
# Fixed loopback port the Companion's WebSocket + /healthz bind to.
COMPANION_PORT=7720
#
# Shared HS256 secret. The dispatch api (POST /api/companion/sessions) MINTS
# short-TTL single-use connection tokens; the Companion VERIFIES them. Both
# processes must hold the SAME value. REQUIRED — the Companion will not start
# without it (an empty secret would verify any token).
# Generate: openssl rand -hex 32
COMPANION_TOKEN_SECRET=replace-with-openssl-rand-hex-32-output
#
# Repo root the Companion opens `claude` at (gives `claude` the whole
# boolean-knowledge knowledge base as ambient file context).
BOOLEAN_KNOWLEDGE_ROOT=~/boolean-knowledge
#
# Strict exact-match Origin allowlist for the Companion WebSocket upgrade
# (comma-separated). Optional — defaults cover local Vite + dispatch.paintos.app.
# COMPANION_ALLOWED_ORIGINS=http://localhost:5173,https://dispatch.paintos.app
