# dispatch — environment variables
# Copy to .env and fill in values before running locally.
# NEVER commit a .env file with real secrets.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (Railway Postgres plugin or local) ───────────────────────────────
# Railway injects DATABASE_URL automatically for the managed Postgres plugin.
# For local dev: postgres://user:password@localhost:5432/dispatch
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dispatch

# ── Clerk Auth ─────────────────────────────────────────────────────────────────
# Publishable key (safe to expose to browser — prefixed VITE_ for Vite)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key (server-side only — never expose to browser)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Slack ──────────────────────────────────────────────────────────────────────
# Slack bot token for read operations (channel membership discovery — Slice 4)
# SLACK_BOT_TOKEN=xoxb-...
#
# Slack signing secret for verifying Events API webhook signatures (Slice 4)
# SLACK_SIGNING_SECRET=...
#
# Write-back identity — OQ-2 RESOLVED: per-SE Slack user tokens.
# Replies post AS the sending SE's own Slack user. One token per SE, keyed by
# their Clerk user id. A reply whose SE has no token here fails gracefully
# (the slack_outbox row moves to 'failed' — never crashes the worker).
# SLACK_USER_TOKEN_<clerkUserId>=xoxp-...
# e.g. SLACK_USER_TOKEN_user_3DzgimkNCGSt10Uc4lIDmvhDeS8=xoxp-...

# ── DSP- ID scheme ─────────────────────────────────────────────────────────────
# Postgres sequence start value for display_id (DSP-####).
# The design uses DSP-2876; start at 2900 so demo data does not collide.
# Change this before Slice 3 ships if a different start is preferred.
DSP_ID_START=2900

# ── Undo window ────────────────────────────────────────────────────────────────
# Duration (seconds) of the pre-send undo buffer for Slack reply outbox.
# Default: 10s. Operator may tune this.
SLACK_SEND_WINDOW_SECS=10
