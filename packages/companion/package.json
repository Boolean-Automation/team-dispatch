{
  "name": "@dispatch/companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "dispatch Companion — local PTY-over-WebSocket bridge that surfaces the SE's own claude CLI in the dispatch web UI (ADR-001).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.13",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
